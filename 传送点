-- ========== 更新列表 ==========
local function updateList(scroll, badge)
    -- 清空
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    badge.Text = tostring(#teleportPoints)
    badge.BackgroundColor3 = #teleportPoints > 0 and Color3.new(0.2, 0.7, 0.2) or Color3.new(0.5, 0.5, 0.5)
    
    if #teleportPoints == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -10, 0, 50)
        empty.Position = UDim2.new(0, 5, 0, 10)
        empty.BackgroundTransparency = 1
        empty.Text = "暂无传送点\n点击「保存当前位置」添加"
        empty.TextColor3 = Color3.new(0.6, 0.6, 0.6)
        empty.TextSize = 12
        empty.TextWrapped = true
        empty.Parent = scroll
        scroll.CanvasSize = UDim2.new(0, 0, 0, 70)
        return
    end
    
    local height = 0
    for i, point in ipairs(teleportPoints) do
        local item = Instance.new("TextButton")
        item.Size = UDim2.new(1, -10, 0, 55)
        item.Position = UDim2.new(0, 5, 0, height)
        item.BackgroundColor3 = Color3.new(0.18, 0.18, 0.25)
        item.BackgroundTransparency = 0.2
        item.Text = ""
        item.BorderSizePixel = 0
        item.Parent = scroll
        
        local itemCorner = Instance.new("UICorner")
        itemCorner.CornerRadius = UDim.new(0, 8)
        itemCorner.Parent = item
        
        -- 名称
        local name = Instance.new("TextLabel")
        name.Size = UDim2.new(0.6, -40, 0.5, 0)
        name.Position = UDim2.new(0, 10, 0, 5)
        name.BackgroundTransparency = 1
        name.Text = point.name
        name.TextColor3 = Color3.new

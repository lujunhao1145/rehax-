-- ========== 简单输入框（使用聊天框方式）==========
local function getInputFromChat(defaultName, callback)
    -- 创建临时提示
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 300, 0, 120)
    frame.Position = UDim2.new(0.5, -150, 0.4, -60)
    frame.BackgroundColor3 = Color3.new(0.1, 0.1, 0.15)
    frame.BorderSizePixel = 0
    frame.Parent = playerGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame
    
    -- 标题
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 35)
    title.BackgroundTransparency = 1
    title.Text = "📝 输入传送点名称"
    title.TextColor3 = Color3.new(1, 1, 1)
    title.TextSize = 16
    title.Font = Enum.Font.GothamBold
    title.Parent = frame
    
    -- 输入框
    local input = Instance.new("TextBox")
    input.Size = UDim2.new(0.9, 0, 0, 40)
    input.Position = UDim2.new(0.05, 0, 0.35, 0)
    input.BackgroundColor3 = Color3.new(0.2, 0.2, 0.3)
    input.Text = defaultName
    input.TextColor3 = Color3.new(1, 1, 1)
    input.PlaceholderText = "输入名称..."
    input.Font = Enum.Font.Gotham
    input.TextSize = 14
    input.Parent = frame
    
    local inputCorner = Instance.new("UICorner")
    inputCorner.CornerRadius = UDim.new(0, 8)
    inputCorner.Parent = input
    
    -- 按钮栏
    local btnBar = Instance.new("Frame")
    btnBar.Size = UDim2.new(1, 0, 0, 40)
    btnBar.Position = UDim2.new(0, 0, 1, -40)
    btnBar.BackgroundTransparency = 1
    btnBar.Parent = frame
    
    -- 确认按钮
    local okBtn = Instance.new("TextButton")
    okBtn.Size = UDim2.new(0.45, -5, 1, -5)
    okBtn.Position = UDim2.new(0.05, 0, 0, 0)
    okBtn.BackgroundColor3 = Color3.new(0.2, 0.6, 0.3)
    okBtn.Text = "✓ 确认"
    okBtn.TextColor3 = Color3.new(1, 1, 1)
    okBtn.TextSize = 14
    okBtn.Font = Enum.Font.GothamBold
    okBtn.BorderSizePixel = 0
    okBtn.Parent = btnBar
    
    local okCorner = Instance.new("UICorner")
    okCorner.CornerRadius = UDim.new(0, 8)
    okCorner.Parent = okBtn
    
    -- 取消按钮
    local cancelBtn = Instance.new("TextButton")
    cancelBtn.Size = UDim2.new(0.45, -5, 1, -5)
    cancelBtn.Position = UDim2.new(0.55, 0, 0, 0)
    cancelBtn.BackgroundColor3 = Color3.new(0.6, 0.3, 0.3)
    cancelBtn.Text = "✕ 取消"
    cancelBtn.TextColor3 = Color3.new(1, 1, 1)
    cancelBtn.TextSize = 14
    cancelBtn.Font = Enum.Font.GothamBold
    cancelBtn.BorderSizePixel = 0
    cancelBtn.Parent = btnBar
    
    local cancelCorner = Instance.new("UICorner")
    cancelCorner.CornerRadius = UDim.new(0, 8)
    cancelCorner.Parent = cancelBtn
    
    -- 确认回调
    local function confirm()
        local name = input.Text
        if name == "" then
            name = defaultName
        end
        frame:Destroy()
        if callback then
            callback(name)
        end
    end
    
    okBtn.MouseButton1Click:Connect(confirm)
    cancelBtn.MouseButton1Click:Connect(function()
        frame:Destroy()
    end)
    
    -- 回车确认
    input.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            confirm()
        end
    end)
    
    -- 自动聚焦
    task.wait(0.1)
    input:CaptureFocus()
end

